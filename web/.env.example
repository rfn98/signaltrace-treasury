# SignalTrace Treasury — local environment.
# Never commit real credentials. `.env` is gitignored; this file is the safe template.

# PostgreSQL connection string used by Prisma (migration, client, seed).
# Supabase / Neon / local Postgres are all acceptable for development.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Milestone I — investigation endpoint
# ---------------------------------------------------------------------------
# Read-only JSON-RPC endpoint for Arbitrum Sepolia, used to observe authoritative chain state by
# `GET /api/investigations/:paymentId` and, since Milestone J, by the Server Component pages `/`
# (treasury overview) and `/payments` (payment list). Both halves resolve the endpoint through the
# same `resolveRpcUrl()` in `lib/chain/adapter.ts`, so there is one definition of where reads go.
#
# No endpoint URL is hardcoded anywhere in the source. If this is left blank, viem falls back to the
# chain's own default public RPC, so reads usually still succeed — but that endpoint is public and
# rate-limited, and it fails intermittently (measured here: the identical request failed once in
# 194ms and succeeded once in 760ms). Every read is bounded to 10s with 1 retry, so a stalled
# endpoint surfaces as 503 DEPENDENCY_UNAVAILABLE rather than a request that never returns.
# Setting a dedicated endpoint removes the flakiness and is recommended for development.
#
# `investigate:payment` additionally falls back to RPC_URL in contracts/.env.
ARBITRUM_SEPOLIA_RPC_URL=

# ---------------------------------------------------------------------------
# Milestone H — advisory AI Investigator (Ollama Cloud)
# ---------------------------------------------------------------------------
# Server-side only. Read inside the provider; never exposed to the browser, never
# written to the database, and never logged. Rotating the key requires no code change.
#
# `investigator:ollama` fails fast and by name if any of these is missing or wrong.
# There is no local fallback: a missing base URL must surface as a misconfiguration
# rather than silently redirect traffic to whatever is listening on localhost.
#
# Accepts either https://ollama.com or https://ollama.com/api.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
# Pinned. The provider refuses any other value instead of substituting one.
OLLAMA_MODEL=gpt-oss:20b
# Optional; defaults to 60000.
OLLAMA_TIMEOUT_MS=
