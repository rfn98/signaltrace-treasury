# Milestone D - Arbitrum Sepolia deployment configuration (TEMPLATE - contains no secrets).
#
# The real file is `contracts/.env`, which is gitignored (see ../../.gitignore). Never commit the
# real file, never paste a key into a chat or a log.
#
# `Deploy.s.sol` reads these with `vm.envUint` / `vm.envAddress` INSIDE the script, so no key is
# ever passed on a command line. Do not switch to `forge script --private-key $KEY`.

# ---------------------------------------------------------------------------------------------
# Deployer / owner. For this deployment DEPLOYER == OWNER, so one key covers both: it pays for gas
# and it holds OWNER_ROLE. Arbitrum Sepolia ETH is required; a few cents is plenty, because gas
# is ~0.03 gwei and the two deployments are roughly 14k + 300k gas.
# ---------------------------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=

# The deploy script derives OWNER_ADDRESS from DEPLOYER_PRIVATE_KEY and asserts the two match,
# so the key can never be paired with the wrong address by accident.
OWNER_ADDRESS=

# ---------------------------------------------------------------------------------------------
# Agent and stranger. Three identities must be pairwise distinct; the script refuses to deploy
# otherwise. AGENT is granted AGENT_ROLE by the Treasury constructor. STRANGER is granted nothing
# and exists purely to prove that "no role" is observable on-chain.
#
# AGENT_PRIVATE_KEY / STRANGER_PRIVATE_KEY are local throwaway testnet identities. They are not
# needed for deployment (only the addresses are), but keeping them lets you drive AGENT actions
# later without importing a fresh wallet. Never commit them.
# ---------------------------------------------------------------------------------------------
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=
STRANGER_ADDRESS=
STRANGER_PRIVATE_KEY=

# ---------------------------------------------------------------------------------------------
# Network. The script refuses to broadcast unless the live chain id equals CHAIN_ID, which is
# what stops a mis-pasted RPC from deploying to mainnet.
# ---------------------------------------------------------------------------------------------
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
CHAIN_ID=421614

# ---------------------------------------------------------------------------------------------
# Filled in by the deploy step; consumed by `Verify.s.sol` for read-only on-chain checks.
# ---------------------------------------------------------------------------------------------
TOKEN_ADDRESS=
TREASURY_ADDRESS=
